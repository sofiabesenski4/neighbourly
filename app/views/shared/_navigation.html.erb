<nav aria-label="Main navigation" class="shrink-0 border-b border-stone-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 <%= content_for?(:landing_page) ? "py-2 sm:py-4" : "py-4" %> sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center gap-x-6 <%= content_for?(:landing_page) ? "gap-y-1 sm:gap-y-3" : "gap-y-3" %>">
      <%= link_to root_path, class: "inline-flex min-h-11 shrink-0 items-center gap-2 text-xl font-semibold tracking-tight text-stone-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" do %>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sage-600 text-white">
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" />
          </svg>
        </span>
        neighbourly
      <% end %>

      <div class="order-last flex w-full gap-1 sm:order-none sm:w-auto">
        <%= link_to new_chat_path, aria: { current: ("page" if active_tab == :chat) }, data: { guest_chat_return: true },
              class: ["inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600",
                      active_tab == :chat ? "bg-sage-100 text-sage-700 hover:bg-sage-200" : "text-stone-700 hover:bg-sage-50"] do %>
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z" />
          </svg>
          Chat
        <% end %>
        <%= link_to new_flyer_path, data: { turbo: false, guest_printout_link: true }, aria: { current: ("page" if active_tab == :printout) },
              class: ["inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600",
                      active_tab == :printout ? "bg-sage-100 text-sage-700 hover:bg-sage-200" : "text-stone-700 hover:bg-sage-50"] do %>
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6Z" />
            <path d="M18 12h.01" />
          </svg>
          Printout
        <% end %>
      </div>

      <div class="ml-auto flex min-w-0 items-center gap-3">
        <% if user_signed_in? %>
          <span class="hidden max-w-48 truncate text-sm text-stone-600 lg:block" title="<%= current_user.email %>"><%= current_user.email %></span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-200 bg-white px-3 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" %>
        <% else %>
          <%= link_to "Sign in", new_user_session_path, class: "inline-flex min-h-11 items-center justify-center rounded-lg border border-stone-200 bg-white px-3 py-2.5 text-sm font-medium text-stone-700 transition-colors hover:bg-stone-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" %>
        <% end %>
      </div>
    </div>

    <% if user_signed_in? && current_user.admin? %>
      <div class="mt-3 flex min-w-0 items-center gap-3 border-t border-stone-100 pt-2">
        <span class="hidden shrink-0 rounded-full bg-sage-50 px-2.5 py-1 text-xs font-semibold text-sage-700 sm:inline-flex">Admin</span>
        <div role="group" aria-label="Administration" class="flex min-w-0 flex-1 gap-1 overflow-x-auto">
          <% [["Users", users_path, %w[users]], ["Sources", sources_path, %w[sources documents]], ["Moderation", reports_path, %w[reports]], ["Models", models_path, %w[models]]].each do |label, path, controllers| %>
            <% active = controllers.include?(controller_name) %>
            <%= link_to label, path, aria: { current: ("page" if active) },
                class: ["inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg px-2 py-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600 sm:px-3",
                        active ? "bg-sage-100 text-sage-700 hover:bg-sage-200" : "text-stone-600 hover:bg-sage-50 hover:text-sage-700"] %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</nav>
