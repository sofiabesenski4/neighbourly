<%# Holds the place of a flow that isn't built: finding help for someone else. To replace it,
    point its route at the real flow, then delete this page and its PagesController action. %>
<% content_for :title, "Find help for someone else" %>
<% link_classes = "inline-flex min-h-11 items-center justify-center rounded-lg px-4 py-2.5 font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" %>

<div class="mx-auto max-w-2xl rounded-xl border border-stone-200 bg-white p-4 sm:p-6">
  <h1 class="text-xl font-semibold tracking-tight text-stone-900 sm:text-2xl">Find help for someone else</h1>
  <p class="mt-2 text-stone-700">Finding help for someone else isn't ready yet. You can ask in chat, or make a printout to give them.</p>

  <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
    <%= link_to "Ask in chat", new_chat_path, class: "#{link_classes} bg-sage-600 text-white hover:bg-sage-700" %>
    <%# Turbo is off, as it is for every other link to the printout builder. %>
    <%= link_to "Make a printout", new_flyer_path, data: { turbo: false }, class: "#{link_classes} border border-sage-600 text-sage-800 hover:bg-sage-50" %>
    <%= link_to "Back to home", root_path, class: "#{link_classes} text-sage-800 underline hover:bg-sage-50 sm:ml-auto" %>
  </div>
</div>
