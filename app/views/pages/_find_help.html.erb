<%# Asks who someone is looking for help for. Each answer starts its own flow.

    These are plain links with Turbo off, so each is a full page load: screen readers announce
    the new page, and an unsaved guest chat is let go for both answers alike. The heading
    describes the links, because "For myself" means little when read out alone. %>
<% link_classes = "inline-flex min-h-14 items-center justify-center gap-2 rounded-xl border border-sage-600 px-4 py-3 text-lg font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" %>
<section aria-labelledby="find-help-heading" class="mt-6 text-left sm:mt-5">
  <h2 id="find-help-heading" class="text-base font-semibold text-stone-900 sm:text-center">Who are you looking for help for?</h2>
  <div class="mt-3 grid gap-2 sm:grid-cols-2 sm:gap-3">
    <%= link_to find_help_for_myself_path, data: { turbo: false }, aria: { describedby: "find-help-heading" },
          class: "#{link_classes} bg-sage-600 text-white hover:bg-sage-700" do %>
      For myself
      <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12h16m-6-6 6 6-6 6" />
      </svg>
    <% end %>
    <%= link_to find_help_for_someone_else_path, data: { turbo: false }, aria: { describedby: "find-help-heading" },
          class: "#{link_classes} bg-white text-sage-800 hover:bg-sage-50" do %>
      For someone else
      <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12h16m-6-6 6 6-6 6" />
      </svg>
    <% end %>
  </div>
</section>
