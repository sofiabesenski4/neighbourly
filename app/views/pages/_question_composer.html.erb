<section class="mt-6 text-left" aria-label="Start a chat" data-controller="composer">
  <%= form_with scope: :chat, url: start_chat_path,
        class: "rounded-2xl border border-stone-200 bg-white px-3 py-3 sm:px-4 focus-within:border-sage-500",
        data: { action: "submit->composer#validate" } do |form| %>
    <%= form.label :prompt, "What are you looking for?", class: "block text-sm font-medium text-stone-900" %>
    <% if @landing_question.errors.any? %>
      <div id="landing-question-error" role="alert" class="mt-3 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700">
        <% @landing_question.errors.each do |error| %>
          <p><%= error.message %></p>
        <% end %>
      </div>
    <% end %>
    <div class="mt-1.5 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-1.5 rounded-[10px] border border-stone-200 bg-stone-50 p-1.5 sm:mt-0 sm:block sm:border-0 sm:bg-transparent sm:p-0">
      <%= form.text_area :prompt, value: @landing_question.prompt, rows: 1, maxlength: LandingQuestion::MAX_LENGTH,
            placeholder: "Where can I get a free meal downtown?",
            aria: { invalid: @landing_question.errors.any?, describedby: token_list("landing-question-shortcuts", ("landing-question-error" if @landing_question.errors.any?)) },
            data: { composer_target: "input", action: "input->composer#resize keydown->composer#submitOnEnter" },
            class: "block min-h-[3.25rem] max-h-64 w-full resize-none overflow-y-auto border-0 bg-transparent px-1.5 py-1 text-base leading-6 text-stone-900 placeholder:text-stone-500 focus:outline-none sm:mt-1 sm:min-h-6 sm:p-0" %>
      <%= form.button type: :submit, aria: { label: "Start chat" }, data: { composer_target: "submit" },
            class: "group inline-flex size-11 min-h-11 items-center justify-center rounded-full font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600 disabled:cursor-not-allowed disabled:opacity-50 sm:mt-2 sm:ml-auto sm:flex sm:h-auto sm:w-fit sm:gap-2 sm:rounded-lg sm:bg-sage-600 sm:px-4 sm:py-2.5 sm:text-sm sm:hover:bg-sage-700" do %>
        <span class="hidden sm:inline">Start chat</span>
        <span class="inline-flex size-9 items-center justify-center rounded-full bg-sage-600 group-hover:bg-sage-700 sm:hidden">
          <svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19V5m-6 6 6-6 6 6" />
          </svg>
        </span>
        <svg aria-hidden="true" class="hidden size-4 shrink-0 sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 12h16m-6-6 6 6-6 6" />
        </svg>
      <% end %>
    </div>
    <span id="landing-question-shortcuts" class="sr-only">Enter to send. Shift+Enter for a new line.</span>
  <% end %>

  <div class="mt-5 hidden flex-wrap items-center justify-center gap-2 sm:flex" role="group" aria-label="Suggested questions">
    <span class="text-sm text-stone-600">Or try</span>
    <% [
      ["Find food", "Where can I get a free meal downtown?", "M4 3v6a2 2 0 0 0 4 0V3M6 3v18M20 21V3c-4 2-4 9 0 9"],
      ["Find shelter", "Where can I find shelter tonight?", "M3 10V5m0 14V10h18v9M3 15h18M7 10V7h4v3m0 0V7h6a4 4 0 0 1 4 4"],
      ["Find a shower", "Where can I have a shower?", "M7 10V6a4 4 0 0 1 8 0m-4 8 1-4h6l1 4h-8Zm2 3v1m4-1v1m-6 3v1m4-1v1m4-1v1"]
    ].each do |label, question, icon_path| %>
      <button type="button" data-action="composer#useSuggestion" data-composer-prompt-param="<%= question %>"
              class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-stone-200 bg-white px-3 py-2 text-sm text-stone-700 hover:border-sage-400 hover:bg-sage-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600">
        <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="<%= icon_path %>" />
        </svg>
        <%= label %>
      </button>
    <% end %>
  </div>
</section>
