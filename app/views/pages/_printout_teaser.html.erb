<section aria-labelledby="printout-heading" class="mt-3 grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 border-t border-stone-200 pt-2 text-left sm:mt-6 sm:gap-x-6 sm:pt-4">
  <div class="col-span-2 flex items-center gap-2 sm:col-span-1">
    <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-sage-100 text-sage-700 sm:h-7 sm:w-7">
      <svg aria-hidden="true" class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 9V3h12v6M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6Z" />
        <path d="M18 12h.01" />
      </svg>
    </span>
    <h2 id="printout-heading" class="text-sm font-semibold text-stone-900 sm:text-base">Prefer a paper copy?</h2>
  </div>
  <p class="text-[0.8125rem] leading-tight text-stone-600 sm:ml-9 sm:text-sm sm:leading-relaxed">Print a guide with addresses, hours, and contacts.</p>
  <%= link_to new_flyer_path, data: { turbo: false },
        class: "inline-flex min-h-11 items-center justify-center gap-1.5 rounded-lg bg-sage-600 px-2.5 py-2 text-xs sm:col-start-2 sm:row-span-2 sm:row-start-1 sm:gap-2 sm:px-4 sm:text-sm font-semibold text-white hover:bg-sage-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" do %>
    Create printout
    <svg aria-hidden="true" class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h16m-6-6 6 6-6 6" />
    </svg>
  <% end %>
</section>
