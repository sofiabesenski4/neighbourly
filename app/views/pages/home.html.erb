<% content_for :title, "Neighbourly Resources" %>

<div class="flex flex-col items-center py-8 sm:py-12">
  <div class="mx-auto w-full max-w-[50.5rem] text-center">
    <%= render "hero" %>
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <% if user_signed_in? %>
        <%= link_to "Ask anything", new_chat_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
      <% else %>
        <%= link_to "Get started", new_user_registration_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
        <%= link_to "Sign in", new_user_session_path, class: "inline-flex items-center justify-center px-6 py-3 border border-stone-300 text-base font-medium rounded-md text-stone-700 bg-white hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
      <% end %>
      <%= link_to "Make a printable flyer", new_flyer_path, data: { turbo: false }, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
    </div>
  </div>

  <%= render "community_features" %>
</div>
