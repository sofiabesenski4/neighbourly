<%# A question where people can choose any number of options.
    Locals: question (Questionnaire::Question), chosen (the options already ticked). %>
<div class="mt-4 grid gap-1 sm:grid-cols-2">
  <% question.options.each do |option| %>
    <label class="flex min-h-11 cursor-pointer items-center gap-2.5 rounded-[7px] p-2.5 text-base text-stone-800 hover:bg-sage-50 has-checked:bg-sage-100">
      <%= check_box_tag "questionnaire[answers][#{question.key}][]", option.key, chosen.include?(option),
            id: "#{question.key}_#{option.key}",
            class: "h-5 w-5 shrink-0 rounded border-stone-400 accent-sage-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" %>
      <span class="min-w-0 break-words"><%= option.label %></span>
    </label>
  <% end %>
</div>
