<%# A question where people can choose any number of options.
    Locals: question (Questionnaire::Question), answer (Questionnaire::Answer). %>
<% options_by_parent = question.options.group_by(&:parent_key) %>
<div class="mt-4 sm:columns-2 sm:gap-x-4" data-controller="category-selection" data-action="change->category-selection#update">
  <% options_by_parent.fetch(nil, []).each do |option| %>
    <% children = options_by_parent.fetch(option.key, []) %>
    <%= tag.div class: "min-w-0 break-inside-avoid mb-1 last:mb-0", role: ("group" if children.any?), aria: {label: (option.label if children.any?)} do %>
      <% [option, *children].each do |choice| %>
        <label class="<%= class_names("flex min-h-11 cursor-pointer items-center gap-2.5 rounded-[7px] p-2.5 text-base text-stone-800 hover:bg-sage-50 has-checked:bg-sage-100", ("ml-5 pl-3" if choice.parent_key)) %>">
          <%= check_box_tag "questionnaire[answers][#{question.key}][]", choice.key, answer.options.include?(choice),
                id: "#{question.key}_#{choice.key}",
                data: {category_selection_target: "option", category_selection_parent: choice.parent_key},
                class: "h-5 w-5 shrink-0 rounded border-stone-400 accent-sage-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600" %>
          <span class="min-w-0 break-words"><%= choice.label %></span>
        </label>
      <% end %>
    <% end %>
  <% end %>
</div>
