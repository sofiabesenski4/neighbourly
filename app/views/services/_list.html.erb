<div class="space-y-4">
  <% services.each do |service| %>
    <article class="admin-panel flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
      <div class="min-w-0 space-y-2">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <%= link_to service.name, service, class: "admin-link text-base" %>
          <% if service.closed? %>
            <span class="admin-badge bg-stone-100 text-stone-600">CLOSED</span>
          <% end %>
        </div>
        <% details = [(service.organization&.name if show_organization), service.city, service.category_names.presence&.join(", ")].compact_blank %>
        <% if details.any? %>
          <p class="break-words text-sm text-stone-500"><%= details.join(" · ") %></p>
        <% end %>
      </div>
      <div class="flex shrink-0 flex-wrap items-center gap-2">
        <%= link_to "Edit", edit_service_path(service), class: "admin-button-secondary" %>
      </div>
    </article>
  <% end %>
</div>
