<% local_assigns.fetch(:responses, [response].compact).each do |record| %>
  <% messages = [record.user_message] %>
  <% messages << record.assistant_message unless record.active? %>
  <% messages.compact.each do |message| %>
    <% next unless message.conversation_visible? %>
    <%= turbo_stream_action_tag :append, target: "messages", template: render(message),
      data: { response_snapshot: true, response_id: response.id, response_version: chat_sync_version(response) } %>
  <% end %>
<% end %>
<%= turbo_stream.replace "chat_#{chat.id}_response_status", partial: "chats/response_status", locals: { chat: chat, response: response } %>
