<% content_for :title, title %>

<div class="mx-auto w-full max-w-md min-w-0 space-y-6 py-4 sm:py-8">
  <header class="text-center">
    <h1 class="text-2xl font-semibold tracking-tight text-stone-900 sm:text-3xl"><%= title %></h1>
    <% if local_assigns[:description].present? %>
      <p class="mt-2 text-sm text-stone-600"><%= description %></p>
    <% end %>
  </header>

  <%= yield %>

  <%= render "devise/shared/links" if local_assigns.fetch(:show_links, true) %>
</div>
