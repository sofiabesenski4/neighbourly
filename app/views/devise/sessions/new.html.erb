<% content_for :sign_in_page, "true" %>

<%= render layout: "devise/shared/form_layout", locals: {title: "Sign in to your account", description: "Welcome back to Neighbourly Resources"} do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: {class: "account-form space-y-5", data: {guest_chat_sign_in: true}}) do |f| %>
    <div class="space-y-2">
      <%= f.label :email, "Email address", class: "account-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "account-input", placeholder: "you@example.com" %>
    </div>

    <div class="space-y-2">
      <%= f.label :password, "Password", class: "account-label" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "account-input", placeholder: "Enter your password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex min-h-11 cursor-pointer items-center gap-3 text-sm text-stone-700">
        <%= f.check_box :remember_me, class: "size-4 shrink-0 accent-sage-600 focus-visible:outline-sage-600" %>
        Remember me
      </label>
    <% end %>

    <fieldset data-guest-chat-save hidden class="rounded-lg border border-stone-200 bg-white p-3 text-sm">
      <label class="flex min-h-11 cursor-pointer items-center gap-3 font-medium text-stone-900">
        <input type="checkbox" class="size-4 shrink-0 accent-sage-700" checked>
        Save guest chats
      </label>
      <p class="mt-1 text-stone-600">You can find them in your chat history after signing in.</p>
    </fieldset>

    <%= f.submit "Sign in", class: "account-submit" %>
  <% end %>
<% end %>
