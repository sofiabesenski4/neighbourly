<%= render layout: "devise/shared/form_layout", locals: {title: "Create your account", description: "Join Neighbourly Resources today"} do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: {class: "account-form space-y-5"}) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-2">
      <%= f.label :email, "Email address", class: "account-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "account-input", placeholder: "you@example.com", aria: {invalid: resource.errors[:email].any?} %>
    </div>

    <div class="space-y-2">
      <%= f.label :password, "Password", class: "account-label" %>
      <% if @minimum_password_length %>
        <p id="password-length-hint" class="text-sm text-stone-500"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "account-input", placeholder: "Create a password",
            aria: {invalid: resource.errors[:password].any?, describedby: ("password-length-hint" if @minimum_password_length)} %>
    </div>

    <div class="space-y-2">
      <%= f.label :password_confirmation, "Confirm password", class: "account-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "account-input", placeholder: "Confirm your password", aria: {invalid: resource.errors[:password_confirmation].any?} %>
    </div>

    <%= f.submit "Sign up", class: "account-submit" %>
  <% end %>
<% end %>
