<%= render layout: "devise/shared/form_layout", locals: {title: "Edit your account", description: "Manage your email and password.", show_links: false} do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: {method: :put, class: "account-form space-y-5"}) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-2">
      <%= f.label :email, class: "account-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "account-input", aria: {invalid: resource.errors[:email].any?} %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="break-words text-sm text-stone-600">Currently waiting confirmation for: <%= resource.unconfirmed_email %></p>
    <% end %>

    <div class="space-y-2">
      <%= f.label :password, class: "account-label" %>
      <p id="account-password-hint" class="text-sm text-stone-500">Leave blank to keep your current password.<% if @minimum_password_length %> <%= @minimum_password_length %> characters minimum.<% end %></p>
      <%= f.password_field :password, autocomplete: "new-password", class: "account-input", aria: {invalid: resource.errors[:password].any?, describedby: "account-password-hint"} %>
    </div>

    <div class="space-y-2">
      <%= f.label :password_confirmation, class: "account-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "account-input", aria: {invalid: resource.errors[:password_confirmation].any?} %>
    </div>

    <div class="space-y-2">
      <%= f.label :current_password, class: "account-label" %>
      <p id="current-password-hint" class="text-sm text-stone-500">Enter your current password to confirm your changes.</p>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "account-input", aria: {invalid: resource.errors[:current_password].any?, describedby: "current-password-hint"} %>
    </div>

    <%= f.submit "Update", class: "account-submit" %>
  <% end %>

  <section class="space-y-3 border-t border-stone-200 pt-6" aria-labelledby="cancel-account-heading">
    <h2 id="cancel-account-heading" class="text-lg font-semibold text-stone-900">Cancel my account</h2>
    <%= button_to "Cancel my account", registration_path(resource_name), data: {confirm: "Are you sure?", turbo_confirm: "Are you sure?"}, method: :delete, class: "admin-button-danger w-full" %>
  </section>

  <%= link_to "Back", :back, class: "inline-flex min-h-11 items-center rounded-lg text-sm font-medium text-sage-700 underline focus-visible:outline-sage-600" %>
<% end %>
