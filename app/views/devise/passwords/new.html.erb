<%= render layout: "devise/shared/form_layout", locals: {title: "Forgot your password?", description: "We'll send you a link to reset your password."} do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :post, class: "account-form space-y-5"}) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-2">
      <%= f.label :email, class: "account-label" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "account-input", aria: {invalid: resource.errors[:email].any?} %>
    </div>

    <%= f.submit "Send me password reset instructions", class: "account-submit whitespace-normal" %>
  <% end %>
<% end %>
