<%= render layout: "devise/shared/form_layout", locals: {title: "Change your password", description: "Choose a new password for your account."} do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :put, class: "account-form space-y-5"}) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div class="space-y-2">
      <%= f.label :password, "New password", class: "account-label" %>
      <% if @minimum_password_length %>
        <p id="password-length-hint" class="text-sm text-stone-500"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "account-input",
            aria: {invalid: resource.errors[:password].any?, describedby: ("password-length-hint" if @minimum_password_length)} %>
    </div>

    <div class="space-y-2">
      <%= f.label :password_confirmation, "Confirm new password", class: "account-label" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "account-input", aria: {invalid: resource.errors[:password_confirmation].any?} %>
    </div>

    <%= f.submit "Change my password", class: "account-submit" %>
  <% end %>
<% end %>
