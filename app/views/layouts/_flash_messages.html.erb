<% if notice.present? || alert.present? %>
  <% top_classes = if shared_navigation
       user_signed_in? && current_user.admin? ? "top-52 sm:top-36" : "top-36 sm:top-20"
     else
       "top-20"
     end %>
  <div aria-label="Notifications" data-turbo-temporary class="pointer-events-none fixed inset-x-4 <%= top_classes %> z-50 flex flex-col items-end gap-3 sm:left-auto sm:w-96">
    <% { notice: notice, alert: alert }.each do |kind, message| %>
      <% next if message.blank? %>
      <% error = kind == :alert %>
      <%= tag.div role: error ? "alert" : "status", aria: { atomic: true },
        data: { controller: "flash", flash_duration_value: error ? 0 : 6000, action: "pointerenter->flash#pause pointerleave->flash#resume focusin->flash#pause focusout->flash#resume" },
        class: ["pointer-events-auto flex w-full items-start gap-3 rounded-xl border bg-white p-4 shadow-lg", error ? "border-red-200 text-red-800" : "border-sage-200 text-sage-800"] do %>
        <p class="min-w-0 flex-1 break-words text-sm leading-6"><%= message %></p>
        <button type="button" aria-label="Dismiss notification" data-action="flash#dismiss" class="-m-1 shrink-0 rounded-lg p-2 text-stone-500 hover:bg-stone-100 focus-visible:outline-sage-600">
          <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      <% end %>
    <% end %>
  </div>
<% end %>
