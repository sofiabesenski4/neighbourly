<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Neighbourly Resources" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Neighbourly Resources">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= Sentry.get_trace_propagation_meta.html_safe if Rails.env.production? || Rails.env.staging? %>
  </head>

  <body class="<%= content_for?(:chat_workspace) ? "h-dvh flex flex-col overflow-hidden bg-white" : "h-full bg-stone-50" %>">
    <!-- Navigation -->
    <nav aria-label="Main navigation" class="shrink-0 bg-white border-b border-stone-100" data-controller="mobile-menu">
      <div class="<%= content_for?(:chat_workspace) ? "w-full px-4" : "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" %>">
        <div class="flex justify-between <%= content_for?(:chat_workspace) ? "h-14" : "h-16" %>">
          <div class="flex">
            <div class="flex-shrink-0 flex items-center">
              <%= link_to "Neighbourly Resources", root_path, class: "#{content_for?(:chat_workspace) ? "text-lg" : "text-xl"} font-semibold tracking-tight text-stone-900" %>
            </div>
            <div class="<%= content_for?(:chat_workspace) ? "hidden lg:ml-8 lg:flex lg:space-x-6" : "hidden sm:ml-8 sm:flex sm:space-x-6" %>">
              <%= link_to "Flyers", new_flyer_path, data: { turbo: false }, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-stone-700 hover:text-stone-900 border-b-2 border-transparent hover:border-sage-500 transition-colors" %>
              <% if user_signed_in? %>
                <%= link_to "Chat", new_chat_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-stone-700 hover:text-stone-900 border-b-2 border-transparent hover:border-sage-500 transition-colors" %>
                <% if current_user.admin? %>
                  <%= link_to "Users", users_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-stone-700 hover:text-stone-900 border-b-2 border-transparent hover:border-sage-500 transition-colors" %>
                  <%= link_to "Sources", sources_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-stone-700 hover:text-stone-900 border-b-2 border-transparent hover:border-sage-500 transition-colors" %>
                  <%= link_to "Moderation", reports_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-stone-700 hover:text-stone-900 border-b-2 border-transparent hover:border-sage-500 transition-colors" %>
                <% end %>
              <% end %>
            </div>
          </div>
          <div class="<%= content_for?(:chat_workspace) ? "hidden lg:flex" : "hidden sm:flex" %> items-center space-x-4">
            <% if user_signed_in? %>
              <span class="min-w-0 max-w-48 truncate text-sm text-stone-600" title="<%= current_user.email %>">
                <%= current_user.email %>
                <% if current_user.admin? %>
                  <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sage-100 text-sage-800">
                    Admin
                  </span>
                <% end %>
              </span>
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-stone-700 hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-stone-500 transition-colors" %>
            <% else %>
              <%= link_to "Sign In", new_user_session_path, class: "inline-flex items-center px-4 py-2 border border-stone-300 text-sm font-medium rounded-md text-stone-700 bg-white hover:bg-stone-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-sage-600 hover:bg-sage-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sage-500 transition-colors" %>
            <% end %>
          </div>
          <div class="flex items-center <%= content_for?(:chat_workspace) ? "lg:hidden" : "sm:hidden" %>">
            <button data-action="mobile-menu#toggle" type="button" class="inline-flex items-center justify-center p-2 rounded-md text-stone-600 hover:text-stone-900 hover:bg-stone-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-sage-500" aria-expanded="false">
              <span class="sr-only">Open main menu</span>
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="hidden <%= content_for?(:chat_workspace) ? "lg:hidden" : "sm:hidden" %> border-t border-stone-200" data-mobile-menu-target="menu">
        <div class="px-4 pt-3">
          <%= link_to "Flyers", new_flyer_path, data: { turbo: false }, class: "block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-stone-900 hover:bg-stone-50" %>
        </div>
        <% if user_signed_in? %>
          <div class="px-4 py-3 space-y-1">
            <%= link_to "Chat", new_chat_path, class: "block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-stone-900 hover:bg-stone-50" %>
            <% if current_user.admin? %>
              <%= link_to "Users", users_path, class: "block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-stone-900 hover:bg-stone-50" %>
              <%= link_to "Sources", sources_path, class: "block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-stone-900 hover:bg-stone-50" %>
              <%= link_to "Moderation", reports_path, class: "block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-stone-900 hover:bg-stone-50" %>
            <% end %>
          </div>
          <div class="border-t border-stone-200 px-4 py-3">
            <div class="text-sm text-stone-600 px-3">
              <%= current_user.email %>
              <% if current_user.admin? %>
                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-sage-100 text-sage-800">Admin</span>
              <% end %>
            </div>
            <div class="mt-2 px-3">
              <%= button_to "Sign Out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-stone-700 hover:bg-stone-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-stone-500 transition-colors" %>
            </div>
          </div>
        <% else %>
          <div class="px-4 py-3 space-y-2">
            <%= link_to "Sign In", new_user_session_path, class: "block px-3 py-2 rounded-md text-base font-medium text-stone-700 hover:text-stone-900 hover:bg-stone-50" %>
            <%= link_to "Sign Up", new_user_registration_path, class: "block px-3 py-2 rounded-md text-base font-medium text-white bg-sage-600 hover:bg-sage-700 text-center rounded-md" %>
          </div>
        <% end %>
      </div>
    </nav>

    <%= render "layouts/flash_messages" %>

    <!-- Main Content -->
    <main class="<%= content_for?(:chat_workspace) ? "flex-1 min-h-0 overflow-hidden" : "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" %>">
      <%= yield %>
    </main>
  </body>
</html>
