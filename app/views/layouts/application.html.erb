<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Neighbourly Resources" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Neighbourly Resources">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= Sentry.get_trace_propagation_meta.html_safe if Rails.env.production? || Rails.env.staging? %>
  </head>

  <% body_classes = if content_for?(:chat_workspace)
       "h-dvh flex flex-col overflow-hidden bg-white"
     elsif content_for?(:landing_page)
       "h-full bg-white"
     else
       "h-full bg-stone-50"
     end %>
  <body class="<%= body_classes %>">
    <!-- Navigation -->
    <% shared_navigation = content_for?(:landing_page) || content_for?(:chat_workspace) || %w[chats flyers].include?(controller_name) %>
    <% if shared_navigation %>
      <% active_tab = if content_for?(:landing_page)
           nil
         elsif controller_name == "flyers"
           :printout
         else
           :chat
         end %>
      <%= render "shared/navigation", active_tab: active_tab %>
    <% else %>
      <%= render "layouts/navigation" %>
    <% end %>

    <%= render "layouts/flash_messages", shared_navigation: shared_navigation %>

    <!-- Main Content -->
    <main class="<%= content_for?(:chat_workspace) ? "flex-1 min-h-0 overflow-hidden" : "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" %>">
      <%= yield %>
    </main>
  </body>
</html>
