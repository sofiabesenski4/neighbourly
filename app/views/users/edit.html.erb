<% content_for :title, "Edit User" %>
<% content_for :admin_actions do %>
  <%= link_to "Back", @user, class: "admin-button-secondary" %>
<% end %>

<%= render "admin/page_header", title: "Edit User", description: "Update user account settings." %>

<div class="admin-panel max-w-3xl p-5 sm:p-6">
  <%= form_with(model: @user, class: "admin-form space-y-6") do |form| %>
    <%= render "admin/form_errors", record: @user, noun: "user" %>

    <div class="space-y-2">
      <%= form.label :email, "Email", class: "admin-label" %>
      <%= form.email_field :email, class: "admin-input", placeholder: "user@example.com", aria: { invalid: @user.errors[:email].any? } %>
    </div>

    <div class="rounded-xl border border-stone-200 bg-stone-50 p-4">
      <div class="flex items-center gap-3">
        <%= form.check_box :admin, class: "admin-checkbox" %>
        <%= form.label :admin, "Admin", class: "admin-label flex min-h-11 items-center" %>
      </div>
      <p class="ml-7 text-sm leading-6 text-stone-500">Grant this user administrator privileges.</p>
    </div>

    <div class="flex flex-wrap items-center gap-3 border-t border-stone-100 pt-6">
      <%= form.submit "Update User", class: "admin-button-primary" %>
      <%= link_to "Cancel", @user, class: "admin-button-secondary" %>
    </div>
  <% end %>
</div>
