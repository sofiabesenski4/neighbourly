<% content_for :title, "User Details" %>
<% content_for :admin_actions do %>
  <%= link_to "Back", users_path, class: "admin-button-secondary" %>
  <%= link_to "Edit User", edit_user_path(@user), class: "admin-button-primary" %>
<% end %>

<%= render "admin/page_header", title: "User Details", description: "View and manage user information." %>

<section class="admin-panel p-5 sm:p-6" aria-labelledby="account_information_heading">
  <h2 id="account_information_heading" class="text-lg font-semibold tracking-tight text-stone-900">Account Information</h2>
  <dl class="mt-6 grid gap-6 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <dt class="text-sm font-medium text-stone-500">Email</dt>
      <dd class="mt-1 break-all text-sm text-stone-900"><%= @user.email %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-stone-500">Role</dt>
      <dd class="mt-2"><span class="admin-badge <%= @user.admin? ? "bg-sage-100 text-sage-800" : "bg-stone-100 text-stone-700" %>"><%= @user.admin? ? "Admin" : "User" %></span></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-stone-500">Total Chats</dt>
      <dd class="mt-1 text-sm text-stone-900"><%= @user.chats.count %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-stone-500">Joined</dt>
      <dd class="mt-1 text-sm text-stone-900"><time datetime="<%= @user.created_at.iso8601 %>"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></time></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-stone-500">Last Updated</dt>
      <dd class="mt-1 text-sm text-stone-900"><time datetime="<%= @user.updated_at.iso8601 %>"><%= @user.updated_at.strftime("%B %d, %Y at %I:%M %p") %></time></dd>
    </div>
  </dl>
</section>

<% if @user != current_user %>
  <section class="mt-6 flex flex-col gap-4 rounded-2xl border border-red-200 bg-red-50/50 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6" aria-labelledby="delete_user_heading">
    <div>
      <h2 id="delete_user_heading" class="font-semibold text-red-800">Delete account</h2>
      <p class="mt-1 text-sm leading-6 text-red-700">Permanently delete this user and their conversations.</p>
    </div>
    <%= button_to "Delete User", @user, method: :delete,
        form: { data: { turbo_confirm: "Are you sure you want to delete this user? This action cannot be undone." } },
        class: "admin-button-danger shrink-0" %>
  </section>
<% end %>
