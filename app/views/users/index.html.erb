<% content_for :title, "Users" %>

<%= render "admin/page_header", title: "Users", description: "Manage user accounts and administrator access." %>

<div class="admin-table-container" role="region" aria-label="User accounts" tabindex="0">
  <table class="admin-table">
    <caption class="sr-only">User accounts</caption>
    <thead>
      <tr>
        <th scope="col">Email</th>
        <th scope="col">Role</th>
        <th scope="col">Chats</th>
        <th scope="col">Joined</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <span class="font-medium text-stone-900"><%= user.email %></span>
            <% if user == current_user %>
              <span class="admin-badge ml-2 bg-sage-50 text-sage-700">You</span>
            <% end %>
          </td>
          <td>
            <span class="admin-badge <%= user.admin? ? "bg-sage-100 text-sage-800" : "bg-stone-100 text-stone-700" %>"><%= user.admin? ? "Admin" : "User" %></span>
          </td>
          <td><%= user.chats.count %></td>
          <td class="whitespace-nowrap"><time datetime="<%= user.created_at.iso8601 %>"><%= user.created_at.strftime("%b %d, %Y") %></time></td>
          <td>
            <div class="flex justify-end gap-4">
              <%= link_to "View", user, class: "admin-link" %>
              <%= link_to "Edit", edit_user_path(user), class: "admin-link" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
