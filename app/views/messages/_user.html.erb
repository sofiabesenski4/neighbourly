<% user ||= local_assigns[:message] %>
<div id="message_<%= user.id %>" aria-label="Your message" class="flex justify-end" data-message-version="<%= chat_sync_version(user) %>" data-message-enrichment="<%= message_sync_enrichment(user) %>">
  <div class="min-w-0 max-w-[90%] rounded-2xl bg-stone-100 px-4 py-3 text-stone-800 sm:max-w-[85%]">
    <div id="message_<%= user.id %>_content" class="whitespace-pre-wrap break-words"><%= user.content %></div>
  </div>
</div>
