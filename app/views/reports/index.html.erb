<% content_for :title, "Moderation" %>

<%= render "admin/page_header", title: "Moderation", description: "Review document reports from users and keep community resources accurate." %>

<% if @reports.any? %>
  <div class="admin-table-container" role="region" aria-label="Reported resources" tabindex="0">
    <table class="admin-table">
      <caption class="sr-only">Document reports</caption>
      <thead>
        <tr>
          <th scope="col">Document</th>
          <th scope="col">Reporter</th>
          <th scope="col">Reason</th>
          <th scope="col">Details</th>
          <th scope="col">Status</th>
          <th scope="col">Date</th>
          <th scope="col"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% @reports.each do |report| %>
          <tr>
            <td>
              <p class="font-medium text-stone-900"><%= report.document.title.presence || "Untitled" %></p>
              <%= link_to report.document.source.name, source_path(report.document.source), class: "admin-link text-xs" %>
            </td>
            <td><%= report.user&.email || "Anonymous" %></td>
            <td><%= report.reason.capitalize %></td>
            <td class="max-w-xs break-words"><%= report.details.presence || "—" %></td>
            <td>
              <% case report.status %>
              <% when "pending" %>
                <span class="admin-badge bg-amber-100 text-amber-800">Pending</span>
              <% when "valid" %>
                <span class="admin-badge bg-red-100 text-red-800">Removed</span>
              <% when "dismissed" %>
                <span class="admin-badge bg-stone-100 text-stone-700">Dismissed</span>
              <% end %>
            </td>
            <td class="whitespace-nowrap"><time datetime="<%= report.created_at.iso8601 %>"><%= report.created_at.strftime("%b %d, %Y") %></time></td>
            <td>
              <% if report.pending? %>
                <div class="flex justify-end gap-2 whitespace-nowrap">
                  <%= button_to "Accept removal", validate_report_path(report), method: :patch,
                      class: "admin-button-danger", data: { turbo_confirm: "This will remove '#{report.document.title}' from search results. Continue?" } %>
                  <%= button_to "Dismiss", dismiss_report_path(report), method: :patch,
                      class: "admin-button-secondary", data: { turbo_confirm: "Dismiss this report?" } %>
                </div>
              <% end %>
            </td>
          </tr>
          <tr>
            <td colspan="7">
              <details>
                <summary class="min-h-11 cursor-pointer py-3 text-sm font-medium text-sage-700 focus-visible:outline-sage-600">Flagged content</summary>
                <div class="max-h-48 overflow-auto whitespace-pre-line rounded-xl border border-stone-200 bg-stone-50 p-4 text-sm leading-6 text-stone-700 [overflow-wrap:anywhere]"><%= report.document.content %></div>
              </details>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p class="admin-empty-state">No reports have been submitted.</p>
<% end %>
