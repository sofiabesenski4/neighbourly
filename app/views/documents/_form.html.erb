<%= form_with(model: @document, url: url, class: "admin-form space-y-6",
    data: { controller: "submit-spinner", action: "submit->submit-spinner#submit" }) do |form| %>
  <%= render "admin/form_errors", record: @document, noun: "resource" %>

  <div class="space-y-2">
    <%= form.label :title, "Resource name", class: "admin-label" %>
    <%= form.text_field :title, value: @document.title || params.dig(:document, :title),
        placeholder: "e.g. Harbour Street Society", autofocus: true, class: "admin-input" %>
  </div>

  <div class="space-y-2">
    <%= form.label :description, "Description of services", class: "admin-label" %>
    <%= form.text_area :description, value: @document.metadata&.dig("description") || params.dig(:document, :description),
        placeholder: "Describe the services offered by this resource...", rows: 4, class: "admin-input" %>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="min-w-0 space-y-2">
      <%= form.label :city, "City", class: "admin-label" %>
      <%= form.text_field :city, value: @document.metadata&.dig("city") || params.dig(:document, :city), placeholder: "e.g. Victoria", class: "admin-input" %>
    </div>
    <div class="min-w-0 space-y-2">
      <%= form.label :address, "Street address", class: "admin-label" %>
      <%= form.text_field :address, value: @document.metadata&.dig("address") || params.dig(:document, :address), placeholder: "e.g. 100 Harbour St", class: "admin-input" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="min-w-0 space-y-2">
      <%= form.label :phone, "Phone number(s)", class: "admin-label" %>
      <p id="document_phone_hint" class="text-xs leading-5 text-stone-500">Comma-separated if multiple.</p>
      <%= form.text_field :phone, value: Array(@document.metadata&.dig("phone")).join(", "), placeholder: "e.g. 250-555-0100", class: "admin-input", aria: { describedby: "document_phone_hint" } %>
    </div>
    <div class="min-w-0 space-y-2">
      <%= form.label :email, "Email", class: "admin-label" %>
      <%= form.email_field :email, value: @document.metadata&.dig("email") || params.dig(:document, :email), placeholder: "e.g. info@example.org", class: "admin-input" %>
    </div>
    <div class="min-w-0 space-y-2">
      <%= form.label :website, "Website", class: "admin-label" %>
      <%= form.url_field :website, value: @document.metadata&.dig("website") || params.dig(:document, :website), placeholder: "https://example.org", class: "admin-input" %>
    </div>
  </div>

  <div class="space-y-2">
    <%= form.label :hours, "Hours of operation", class: "admin-label" %>
    <%= form.text_field :hours, value: @document.metadata&.dig("hours") || params.dig(:document, :hours), placeholder: "e.g. Mon-Fri 9am-5pm, Sat 10am-2pm", class: "admin-input" %>
  </div>

  <% selected_category_ids = (params.dig(:document, :category_ids) || @document.category_ids).map(&:to_s) %>
  <fieldset class="min-w-0 space-y-3">
    <legend class="admin-label">Categories</legend>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      <%= form.collection_check_boxes :category_ids, Category.order(:name), :id, :name do |option| %>
        <%= option.label class: "flex min-h-11 cursor-pointer items-center gap-3 rounded-xl border border-stone-200 bg-white px-4 py-3 transition-colors hover:bg-stone-50 has-[:checked]:border-sage-600 has-[:checked]:bg-sage-50" do %>
          <%= option.check_box checked: selected_category_ids.include?(option.value.to_s), class: "admin-checkbox" %>
          <span class="min-w-0 break-words text-sm font-medium text-stone-800"><%= option.text %></span>
        <% end %>
      <% end %>
    </div>
  </fieldset>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="min-w-0 space-y-2">
      <%= form.label :age_min, "Minimum age", class: "admin-label" %>
      <%= form.number_field :age_min, value: @document.metadata&.dig("age_range", "min") || params.dig(:document, :age_min), placeholder: "e.g. 19", min: 0, class: "admin-input" %>
    </div>
    <div class="min-w-0 space-y-2">
      <%= form.label :age_max, "Maximum age", class: "admin-label" %>
      <%= form.number_field :age_max, value: @document.metadata&.dig("age_range", "max") || params.dig(:document, :age_max), placeholder: "e.g. 65", min: 0, class: "admin-input" %>
    </div>
    <div class="min-w-0 space-y-2">
      <%= form.label :gender, "Gender", class: "admin-label" %>
      <p id="document_gender_hint" class="text-xs leading-5 text-stone-500">Comma-separated if multiple.</p>
      <%= form.text_field :gender, value: Array(@document.metadata&.dig("gender")).join(", "), placeholder: "e.g. all, male, female", class: "admin-input", aria: { describedby: "document_gender_hint" } %>
    </div>
  </div>

  <div class="space-y-2">
    <%= form.label :notes, "Additional notes", class: "admin-label" %>
    <%= form.text_area :notes, value: @document.metadata&.dig("notes") || params.dig(:document, :notes), placeholder: "Any other relevant information...", rows: 3, class: "admin-input" %>
  </div>

  <div class="flex flex-wrap items-center gap-3 border-t border-stone-100 pt-6">
    <%= form.submit button_text, data: { submit_spinner_target: "button" }, class: "admin-button-primary" %>
    <%= link_to "Cancel", cancel_path, class: "admin-button-secondary" %>
    <span role="status" data-submit-spinner-target="spinner" class="hidden items-center gap-2 text-sm text-stone-600">
      <svg aria-hidden="true" class="h-5 w-5 animate-spin text-sage-600" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      Processing, this may take a moment...
    </span>
  </div>
<% end %>
