<% content_for :title, @document.title.presence || "Resource" %>
<% content_for :admin_actions do %>
  <%= link_to "Back to sources", sources_path, class: "admin-button-secondary" %>
  <%= link_to "Edit", edit_document_path(@document), class: "admin-button-primary" %>
  <%= button_to "Delete", document_path(@document), method: :delete, class: "admin-button-danger", data: { turbo_confirm: "Delete this resource?" } %>
<% end %>

<%= render "admin/page_header", title: @document.title.presence || "Untitled resource", description: "Review the information available for this community resource." %>

<dl class="admin-panel max-w-4xl divide-y divide-stone-100">
  <% if @document.metadata["description"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Description</dt>
      <dd class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-stone-900"><%= @document.metadata["description"] %></dd>
    </div>
  <% end %>
  <% if @document.metadata["city"].present? || @document.metadata["address"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Location</dt>
      <dd class="mt-2 break-words text-sm leading-6 text-stone-900">
        <%= @document.metadata["address"] %><% if @document.metadata["address"].present? && @document.metadata["city"].present? %>, <% end %><%= @document.metadata["city"] %>
      </dd>
    </div>
  <% end %>
  <% if @document.metadata["phone"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Phone</dt>
      <dd class="mt-2 text-sm leading-6 text-stone-900"><%= Array(@document.metadata["phone"]).join(", ") %></dd>
    </div>
  <% end %>
  <% if @document.metadata["email"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Email</dt>
      <dd class="mt-2 break-all text-sm leading-6 text-stone-900"><%= @document.metadata["email"] %></dd>
    </div>
  <% end %>
  <% if @document.metadata["website"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Website</dt>
      <dd><%= link_to @document.metadata["website"], @document.metadata["website"], target: "_blank", rel: "noopener noreferrer", class: "admin-link" %></dd>
    </div>
  <% end %>
  <% if @document.metadata["hours"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Hours of operation</dt>
      <dd class="mt-2 text-sm leading-6 text-stone-900"><%= @document.metadata["hours"] %></dd>
    </div>
  <% end %>
  <% if @document.categories.any? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Categories</dt>
      <dd class="mt-2 text-sm leading-6 text-stone-900"><%= @document.category_names.join(", ") %></dd>
    </div>
  <% end %>
  <% if @document.metadata["age_range"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Age range</dt>
      <dd class="mt-2 text-sm leading-6 text-stone-900">
        <% min = @document.metadata.dig("age_range", "min") %>
        <% max = @document.metadata.dig("age_range", "max") %>
        <% if min.present? %><%= max.present? ? "#{min} - #{max}" : "#{min}+" %><% end %>
      </dd>
    </div>
  <% end %>
  <% if @document.metadata["gender"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Gender</dt>
      <dd class="mt-2 text-sm leading-6 text-stone-900"><%= Array(@document.metadata["gender"]).join(", ") %></dd>
    </div>
  <% end %>
  <% if @document.metadata["notes"].present? %>
    <div class="px-5 py-4 sm:px-6">
      <dt class="text-sm font-medium text-stone-500">Notes</dt>
      <dd class="mt-2 whitespace-pre-line break-words text-sm leading-6 text-stone-900"><%= @document.metadata["notes"] %></dd>
    </div>
  <% end %>
  <div class="px-5 py-4 sm:px-6">
    <dt class="text-sm font-medium text-stone-500">Full text</dt>
    <dd>
      <details>
        <summary class="min-h-11 cursor-pointer py-3 text-sm font-medium text-sage-700 focus-visible:outline-sage-600">View full text</summary>
        <p class="max-h-80 overflow-y-auto whitespace-pre-wrap break-words rounded-xl bg-stone-50 p-4 text-sm leading-6 text-stone-700"><%= @document.content %></p>
      </details>
    </dd>
  </div>
</dl>
