<% content_for :title, "Edit Resource" %>
<% content_for :admin_actions do %>
  <%= link_to "Back to resource", @document, class: "admin-button-secondary" %>
<% end %>

<%= render "admin/page_header", title: "Edit Resource", description: "Keep this resource's contact details and services up to date." %>

<div class="admin-panel max-w-4xl p-5 sm:p-6">
  <%= render "form", url: document_path(@document), button_text: "Update resource", cancel_path: @document %>
</div>
