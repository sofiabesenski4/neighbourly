<% content_for :title, @model.name %>
<% content_for :admin_actions do %>
  <%= link_to "All models", models_path, class: "admin-button-secondary" %>
  <%= link_to "Start chat with this model", new_chat_path(model: @model.id), class: "admin-button-primary" %>
<% end %>

<%= render "admin/page_header", title: @model.name, description: "Model details and capabilities." %>

<div class="admin-panel p-5 sm:p-6">
  <dl class="grid gap-6 text-sm sm:grid-cols-2">
    <% [["Provider", @model.provider_class&.name&.demodulize || @model.provider.to_s.titleize], ["Model", @model.name], ["ID", @model.id], ["Context Window", (@model.context_window && number_with_delimiter(@model.context_window))], ["Max Output Tokens", (@model.max_output_tokens && number_with_delimiter(@model.max_output_tokens))]].each do |label, value| %>
      <div class="min-w-0">
        <dt class="font-medium text-stone-500"><%= label %></dt>
        <dd class="mt-1 break-words text-stone-900"><%= value.presence || "Not specified" %></dd>
      </div>
    <% end %>
    <% if @model.capabilities.any? %>
      <div class="sm:col-span-2">
        <dt class="font-medium text-stone-500">Capabilities</dt>
        <dd class="mt-2 flex flex-wrap gap-2">
          <% @model.capabilities.each do |capability| %>
            <span class="admin-badge bg-sage-50 text-sage-700"><%= capability %></span>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
</div>
