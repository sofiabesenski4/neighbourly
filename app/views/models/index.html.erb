<% content_for :title, "Models" %>
<% content_for :admin_actions do %>
  <%= link_to "Chats", new_chat_path, class: "admin-button-secondary" %>
  <%= button_to "Refresh Models", refresh_models_path, method: :post, class: "admin-button-primary" %>
<% end %>

<%= render "admin/page_header", title: "Models", description: "Review the configured chat models and their capabilities." %>

<div id="models">
  <% if @models.any? %>
    <div class="admin-table-container" role="region" aria-label="Available models" tabindex="0">
      <table class="admin-table">
        <caption class="sr-only">Available chat models</caption>
        <thead>
          <tr>
            <th scope="col">Provider</th>
            <th scope="col">Model</th>
            <th scope="col">Context Window</th>
            <th scope="col">$/1M tokens (In/Out)</th>
            <th scope="col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @models.each do |model_info| %>
            <%= render "models/model", model: model_info %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="admin-empty-state">No chat models found.</p>
  <% end %>
</div>
