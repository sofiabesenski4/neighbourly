<% row_id = [model.provider, model.id].join("_").parameterize(separator: "_") %>
<tr id="model_<%= row_id %>">
  <td><%= model.provider_class&.name&.demodulize || model.provider.to_s.titleize %></td>
  <td><%= link_to model.name, model_path(model.id, provider: model.provider), class: "admin-link" %></td>
  <td><%= model.context_window ? number_with_delimiter(model.context_window) : "—" %></td>
  <td class="whitespace-nowrap">
    <% input = model.price(:input) %>
    <% output = model.price(:output) %>
    <% if input && output %>
      $<%= "%.2f" % input %> / $<%= "%.2f" % output %>
    <% else %>
      —
    <% end %>
  </td>
  <td><%= link_to "Start chat", new_chat_path(model: model.id), class: "admin-button-secondary whitespace-nowrap" %></td>
</tr>
