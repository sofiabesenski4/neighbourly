<%= link_to new_chat_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-stone-800 hover:bg-stone-200 focus-visible:outline-sage-600" do %>
  <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
  New chat
<% end %>

<h2 class="mt-6 mb-2 px-3 text-xs font-medium text-stone-400">Recent</h2>
<nav aria-label="Recent conversations" class="min-h-0 flex-1 overflow-y-auto space-y-1">
  <% @recent_chats.each do |recent_chat| %>
    <% active = chat.persisted? && recent_chat.id == chat.id %>
    <%= link_to chat_title(recent_chat), recent_chat,
        aria: { current: active ? "page" : nil }, data: { chat_title: recent_chat.id },
        class: "block truncate rounded-lg px-3 py-2 text-sm #{active ? "bg-stone-200 text-stone-900 font-medium" : "text-stone-700 hover:bg-stone-200"}" %>
  <% end %>
  <% if @recent_chats.empty? %>
    <p class="px-2 py-3 text-sm text-stone-500">Your conversations will appear here.</p>
  <% end %>
</nav>

<%= link_to "All chats", chats_path, class: "mt-4 block rounded-lg px-3 py-2 text-xs text-stone-500 hover:bg-stone-200 hover:text-stone-800" %>
