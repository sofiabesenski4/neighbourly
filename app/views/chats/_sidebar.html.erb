<%= link_to new_chat_path, class: "flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium text-stone-800 hover:bg-stone-200 focus-visible:outline-sage-600" do %>
  <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
  New chat
<% end %>

<h2 class="mt-6 mb-2 px-3 text-xs font-medium text-stone-400">Recent</h2>
<nav aria-label="Recent conversations" class="min-h-0 flex-1 overflow-y-auto space-y-1">
  <% @recent_chats.each do |recent_chat| %>
    <% active = chat.persisted? && recent_chat.id == chat.id %>
    <div class="conversation-row group relative flex items-center rounded-lg <%= active ? "bg-stone-200" : "hover:bg-stone-200" %>" data-chat-row="<%= recent_chat.id %>" data-controller="conversation-menu">
      <%= link_to chat_title(recent_chat), conversation_path(recent_chat),
          aria: { current: active ? "page" : nil }, data: { chat_title: recent_chat.id },
          class: "min-w-0 flex-1 truncate rounded-lg px-3 py-2 text-sm #{active ? "text-stone-900 font-medium" : "text-stone-700"}" %>
      <button type="button" aria-label="Conversation options for <%= chat_title(recent_chat) %>" aria-haspopup="menu" aria-expanded="false" data-conversation-menu-target="trigger" class="conversation-menu-trigger mr-1 rounded-md p-2 text-stone-500 hover:bg-stone-300 focus-visible:outline-sage-600">
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.75" /><circle cx="12" cy="12" r="1.75" /><circle cx="19" cy="12" r="1.75" /></svg>
      </button>
      <div popover="auto" role="menu" aria-label="Conversation actions" data-conversation-menu-target="menu" data-action="toggle->conversation-menu#syncState keydown.esc->conversation-menu#close keydown.down->conversation-menu#focusItem keydown.up->conversation-menu#focusItem keydown.tab->conversation-menu#leave" class="fixed inset-auto m-0 w-44 rounded-lg border border-stone-200 bg-white p-1 shadow-lg">
        <%= button_to chat_path(recent_chat), method: :delete,
            params: { from: "workspace", current_chat_id: chat.id },
            data: { turbo_confirm: "Delete this conversation? This cannot be undone." },
            role: "menuitem", class: "w-full rounded-md px-3 py-2 text-left text-sm text-red-600 hover:bg-red-50 focus-visible:outline-red-600" do %>
          Delete conversation
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @recent_chats.empty? %>
    <p class="px-2 py-3 text-sm text-stone-500">Your conversations will appear here.</p>
  <% end %>
</nav>

<% if user_signed_in? %>
  <%= link_to "All chats", chats_path, class: "mt-4 block rounded-lg px-3 py-2 text-xs text-stone-500 hover:bg-stone-200 hover:text-stone-800" %>
<% end %>
