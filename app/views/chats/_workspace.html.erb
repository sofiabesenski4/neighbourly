<div class="flex h-full min-h-0" data-controller="chat-workspace" data-action="turbo:before-cache@document->chat-workspace#closeDrawer">
  <aside id="chat_sidebar" data-chat-workspace-target="sidebar" aria-label="Conversation sidebar" class="hidden w-64 shrink-0 flex-col border-r border-stone-200 bg-stone-100 p-4 md:flex">
    <%= render "sidebar", chat: chat %>
  </aside>

  <dialog id="chat_drawer" data-chat-workspace-target="drawer" data-action="click->chat-workspace#closeOutside close->chat-workspace#drawerClosed" aria-labelledby="chat_drawer_title" class="fixed inset-y-0 left-0 m-0 h-dvh max-h-none w-80 max-w-[85vw] border-0 bg-stone-100 p-0 shadow-xl backdrop:bg-black/40">
    <div class="flex h-full flex-col p-4">
      <div class="mb-4 flex items-center justify-between">
        <h2 id="chat_drawer_title" class="font-semibold text-stone-900">Conversations</h2>
        <button type="button" autofocus data-action="chat-workspace#closeDrawer" class="rounded-lg px-3 py-2 text-sm text-stone-600 hover:bg-stone-200">Close</button>
      </div>
      <%= render "sidebar", chat: chat %>
    </div>
  </dialog>

  <section aria-label="Chat workspace" class="flex min-h-0 min-w-0 flex-1 flex-col">
    <header class="flex shrink-0 flex-wrap items-center gap-3 border-b border-stone-200 bg-white px-4 py-3">
      <button type="button" data-action="chat-workspace#toggleSidebar" data-chat-workspace-target="sidebarToggle" aria-label="Toggle conversation sidebar" aria-controls="chat_sidebar" aria-expanded="true" class="hidden rounded-lg px-2 py-2 text-stone-600 hover:bg-stone-100 md:inline-flex">
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M4 5h16v14H4zM9 5v14" /></svg>
      </button>
      <button type="button" data-action="chat-workspace#openDrawer" data-chat-workspace-target="drawerToggle" aria-label="Open conversations" aria-controls="chat_drawer" aria-haspopup="dialog" aria-expanded="false" class="rounded-lg px-2 py-2 text-stone-600 hover:bg-stone-100 md:hidden">
        <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
      <h1 class="min-w-0 flex-1 truncate text-base font-semibold text-stone-900"><%= chat_title(chat) %></h1>
      <% if chat.persisted? %>
        <p class="w-full truncate text-xs text-stone-500 sm:w-auto sm:max-w-xs" title="<%= chat.model&.label || default_model_display_name %>"><%= chat.model&.label || default_model_display_name %></p>
      <% else %>
        <div class="w-full sm:w-auto sm:max-w-xs">
          <%= label_tag :chat_model, "Select AI model", class: "sr-only" %>
          <%= select_tag "chat[model]",
              options_for_select(@chat_models.map { |model| [model.label, model.id] }.unshift([default_model_display_name, nil]), @selected_model),
              id: "chat_model", form: "new_chat", class: "w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:outline-sage-600" %>
        </div>
      <% end %>
    </header>

    <div class="min-h-0 flex-1 overflow-y-auto px-4 py-6" tabindex="0" aria-label="Conversation">
      <% if chat.persisted? %>
        <div id="messages" class="mx-auto w-full max-w-3xl divide-y divide-gray-200 space-y-5">
          <% chat.messages.where.not(id: nil).each do |message| %>
            <%= render message %>
          <% end %>
        </div>
      <% else %>
        <div class="mx-auto flex min-h-full max-w-3xl flex-col items-center justify-center text-center">
          <p class="mb-3 text-sm font-medium text-sage-700">Neighbourly Resources</p>
          <h2 class="text-2xl font-semibold tracking-tight text-stone-900 sm:text-3xl">What would you like help finding?</h2>
          <p class="mt-3 max-w-md text-sm leading-6 text-stone-500">Ask about local meals, shelter, and community support.</p>
        </div>
      <% end %>
    </div>

    <div class="shrink-0 border-t border-stone-200 bg-stone-50 px-4 py-4 pb-[max(1rem,env(safe-area-inset-bottom))]">
      <div class="mx-auto w-full max-w-3xl rounded-2xl border border-stone-200 bg-white p-4 shadow-sm">
        <% if chat.persisted? %>
          <%= render "messages/form", chat: chat, message: @message %>
        <% else %>
          <%= render "form", chat: chat %>
        <% end %>
      </div>
    </div>
  </section>
</div>
