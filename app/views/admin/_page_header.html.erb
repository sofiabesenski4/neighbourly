<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
  <div class="min-w-0">
    <p class="mb-2 text-xs font-semibold tracking-wide text-sage-700">Administration</p>
    <h1 class="break-words text-2xl font-semibold tracking-tight text-stone-900 sm:text-3xl"><%= title %></h1>
    <% if local_assigns[:description].present? %>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-stone-600"><%= description %></p>
    <% end %>
  </div>
  <% if content_for?(:admin_actions) %>
    <div class="flex shrink-0 flex-wrap items-center gap-2">
      <%= content_for(:admin_actions) %>
    </div>
  <% end %>
</div>
