<% if record.errors.any? %>
  <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-800">
    <h2 class="text-sm font-semibold"><%= pluralize(record.errors.count, "error") %> prohibited this <%= noun %> from being saved:</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-6">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
