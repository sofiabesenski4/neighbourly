<nav aria-label="Administration" class="admin-panel sticky top-6 hidden w-48 shrink-0 p-3 lg:block">
  <p class="px-3 py-2 text-xs font-semibold tracking-wide text-stone-500">Admin console</p>
  <div class="mt-1 space-y-1">
    <% [["Overview", admin_path, %w[admin]], ["Users", users_path, %w[users]], ["Sources", sources_path, %w[sources documents]], ["Moderation", reports_path, %w[reports]], ["Models", models_path, %w[models]]].each do |label, path, controllers| %>
      <% active = controllers.include?(controller_name) %>
      <%= link_to label, path, aria: { current: ("page" if active) },
          class: ["flex min-h-11 items-center rounded-lg px-3 py-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600",
                  active ? "bg-sage-100 text-sage-700 hover:bg-sage-200" : "text-stone-600 hover:bg-sage-50 hover:text-sage-700"] %>
    <% end %>
  </div>
</nav>
