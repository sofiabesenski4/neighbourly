<% content_for :title, "Admin console" %>
<% content_for :admin_actions do %>
  <%= link_to "Upload source", new_source_path, class: "admin-button-secondary" %>
  <%= link_to "Add resource", new_document_path, class: "admin-button-primary" %>
<% end %>

<%= render "admin/page_header", title: "Admin console", description: "Manage the accounts, resources, and reports that keep community support useful." %>

<section aria-label="Administration sections" class="grid grid-cols-2 gap-4">
  <% [["Users", users_path, @user_count, "Manage user accounts and administrator access."], ["Sources", sources_path, @source_count, "#{pluralize(@resource_count, "resource")} across uploaded data and manual entries."], ["Moderation", reports_path, @pending_report_count, "Reports awaiting review."], ["Models", models_path, @model_count, "Configured chat models available to use."]].each do |label, path, count, description| %>
    <%= link_to path, class: "admin-panel block p-5 transition-colors hover:border-sage-300 hover:bg-sage-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage-600 sm:p-6" do %>
      <dl>
        <dt class="text-sm font-medium text-stone-600"><%= label %></dt>
        <dd class="mt-3 text-3xl font-semibold tracking-tight text-stone-900 [overflow-wrap:anywhere]"><%= number_with_delimiter(count) %></dd>
      </dl>
      <p class="mt-2 text-sm leading-6 text-stone-500"><%= description %></p>
      <span class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-sage-700">
        Open
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </span>
    <% end %>
  <% end %>
</section>
