<% content_for :title, "Resources by category" %>

<div class="w-full max-w-5xl mx-auto">
  <h1 class="font-bold text-4xl text-stone-900">Resources by category</h1>
  <% @sections.each do |section| %>
    <section class="mt-8" aria-labelledby="category-<%= section.category.key %>">
      <h2 id="category-<%= section.category.key %>" class="font-bold text-2xl text-stone-900"><%= section.category.name %></h2>
      <% if section.resources.empty? %>
        <p class="mt-3 text-stone-600">No matching resources in this category.</p>
      <% else %>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-5 items-start">
          <% section.resources.each do |resource| %>
            <% card = ResourceCard.new(resource) %>
            <article class="rounded-lg border border-stone-300 bg-white overflow-hidden">
              <h3 class="px-4 py-3 bg-stone-100 font-bold text-lg text-stone-900"><%= card.title %></h3>
              <dl class="p-4 space-y-3">
                <% card.fields.each do |field| %>
                  <div>
                    <dt class="font-semibold text-stone-900"><%= field[:label] %></dt>
                    <dd class="whitespace-pre-line break-words text-stone-800"><%= field[:value] %></dd>
                  </div>
                <% end %>
              </dl>
            </article>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
