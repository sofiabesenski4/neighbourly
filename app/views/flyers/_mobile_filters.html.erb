<%= form.hidden_field :sort, data: { flyer_builder_target: "sort" } %>

<div class="sticky top-0 z-20 -mx-4 grid grid-cols-[minmax(0,1fr)_2.75rem] items-center gap-1.5 border-b border-stone-200 bg-white px-4 py-1 sm:hidden"
     role="search" aria-label="Find resources for your guide" hidden data-flyer-builder-target="toolbar">
  <%= form.label :query, data: { flyer_builder_target: "searchField" },
        class: "relative isolate flex min-h-11 min-w-0 items-center gap-2 px-3 text-stone-600 before:pointer-events-none before:absolute before:inset-x-0 before:inset-y-1 before:-z-10 before:rounded-full before:border before:border-stone-200 before:bg-stone-100 focus-within:before:border-sage-700 focus-within:before:ring-1 focus-within:before:ring-sage-700" do %>
    <span class="sr-only">Search resources</span>
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path stroke-linecap="round" d="m20 20-4-4" />
    </svg>
    <%= form.search_field :query, placeholder: "Search resources", maxlength: Flyer::QUERY_LIMIT,
          enterkeyhint: "search", autocomplete: "off", class: "min-h-11 min-w-0 flex-1 bg-transparent text-base text-stone-900 outline-none placeholder:text-stone-600 sm:text-sm",
          data: { flyer_builder_target: "search", action: "input->flyer-builder#filter keydown.enter->flyer-builder#finishSearch" } %>
  <% end %>
  <button type="button" class="relative isolate grid size-11 cursor-pointer place-items-center text-stone-700 before:pointer-events-none before:absolute before:inset-1 before:-z-10 before:rounded-lg before:border before:border-stone-200 data-[active=true]:text-sage-700 data-[active=true]:before:border-sage-600 data-[active=true]:before:bg-sage-100"
          aria-label="Filters" aria-haspopup="dialog" aria-controls="flyer-filters" aria-expanded="false"
          data-flyer-builder-target="filterButton" data-action="flyer-builder#openFilters">
    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path stroke-linecap="round" d="M3 6h7m4 0h7M3 12h12m4 0h2M3 18h3m4 0h11" />
      <circle cx="12" cy="6" r="2" /><circle cx="17" cy="12" r="2" /><circle cx="8" cy="18" r="2" />
    </svg>
  </button>
</div>

<dialog id="flyer-filters" class="fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overscroll-contain bg-white p-0 text-stone-900"
        aria-labelledby="flyer-filters-heading" hidden data-flyer-builder-target="filterDialog" data-action="close->flyer-builder#filtersClosed">
  <div class="flex h-full flex-col">
    <header class="flex shrink-0 items-center justify-between border-b border-stone-200 px-4 py-2">
      <h2 id="flyer-filters-heading" class="text-xl font-semibold">Filters</h2>
      <button type="button" autofocus class="grid size-11 cursor-pointer place-items-center rounded-lg text-stone-600 hover:bg-stone-100"
              aria-label="Close filters" data-action="flyer-builder#closeFilters">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
          <path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </header>
    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto px-4 py-5">
      <label for="flyer-filter-order" class="block shrink-0 text-sm font-semibold">Sort by</label>
      <select id="flyer-filter-order" class="mt-1.5 min-h-11 w-full shrink-0 rounded-lg border border-stone-300 bg-white px-3 text-base" data-flyer-builder-target="draftSort">
        <%= options_for_select(Flyer::SORT_OPTIONS, selected: @flyer.sort, disabled: Flyer::DISTANCE_SORT) %>
      </select>

      <fieldset class="mt-5 flex min-h-0 flex-1 flex-col">
        <legend class="text-sm font-semibold">Categories</legend>
        <p class="mt-1 mb-2.5 shrink-0 text-sm text-stone-600">Leave unchecked to include all categories.</p>
        <div role="region" aria-label="Category list" tabindex="0"
             class="grid min-h-20 flex-1 content-start gap-1.5 overflow-y-auto overscroll-contain pr-1 [scrollbar-gutter:stable] focus-visible:outline-sage-600">
          <% categories.each do |id, name| %>
            <label class="flex min-h-11 cursor-pointer items-center gap-2.5 rounded-lg border border-stone-200 px-3 py-2 text-sm has-checked:border-sage-600 has-checked:bg-sage-50">
              <input type="checkbox" value="<%= id %>" class="size-4 shrink-0 accent-sage-600" data-flyer-builder-target="draftCategory">
              <span><%= name %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
    </div>
    <footer class="flex shrink-0 gap-2 border-t border-stone-200 bg-white px-4 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))]">
      <button type="button" class="min-h-11 cursor-pointer rounded-lg border border-stone-300 px-4 text-sm font-semibold text-sage-700" data-action="flyer-builder#resetDraft">
        Reset
      </button>
      <button type="button" class="min-h-11 flex-1 cursor-pointer rounded-lg bg-sage-600 px-4 text-sm font-semibold text-white hover:bg-sage-700" data-action="flyer-builder#applyFilters">
        Apply filters
      </button>
    </footer>
  </div>
</dialog>
