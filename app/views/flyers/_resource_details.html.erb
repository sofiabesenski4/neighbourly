<details class="relative shrink-0" data-flyer-builder-target="advancedFilters"
         data-action="click@window->flyer-builder#closeAdvancedFiltersOutside keydown.esc->flyer-builder#closeAdvancedFilters">
  <summary aria-label="Advanced filtering" title="Advanced filtering"
           class="grid size-11 cursor-pointer list-none place-items-center rounded-lg border border-stone-200 bg-white text-stone-700 hover:bg-sage-50 focus-visible:outline-sage-600 [&::-webkit-details-marker]:hidden">
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3 4h18v2l-7 7v5l-4 2v-7L3 6V4z" />
    </svg>
  </summary>

  <div class="absolute top-full right-0 z-20 mt-1 max-h-[60dvh] w-52 overflow-y-auto overscroll-contain rounded-xl border border-stone-200 bg-white p-3 shadow-md">
    <fieldset>
      <legend class="text-sm font-semibold text-stone-900">Resource details</legend>
      <p class="mt-1 text-xs text-stone-600">Choose what to show in the preview.</p>
      <%= hidden_field_tag "print_settings[details][]", "", id: nil %>
      <% selected_details = @flyer.selected_details %>
      <% labels = { "distance" => "Distance and walking time", "eligibility" => "Ages served and eligibility" } %>
      <% Flyer::DETAIL_FIELDS.each do |key, fields| %>
        <label class="flex min-h-11 cursor-pointer items-center gap-2 text-sm text-stone-800">
          <%= check_box_tag "print_settings[details][]", key, selected_details.include?(key),
                id: "print-settings-detail-#{key}",
                class: "size-4 accent-sage-600 focus-visible:outline-sage-600",
                data: { flyer_builder_target: "resourceDetail", field_labels: fields.join(","),
                        action: "change->flyer-builder#updateResourceDetails" } %>
          <span><%= labels.fetch(key, key.capitalize) %></span>
        </label>
      <% end %>
    </fieldset>
  </div>
</details>
