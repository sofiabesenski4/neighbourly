<% content_for :title, "Sources" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from "sources" %>
<% content_for :admin_actions do %>
  <%= link_to "Upload source", new_source_path, class: "admin-button-secondary" %>
  <%= link_to "Add resource", new_document_path, class: "admin-button-primary" %>
<% end %>

<%= render "admin/page_header", title: "Sources", description: "Manage the community resources and uploaded data used in chat and printouts." %>

<% if @sources.any? || @documents.any? %>
  <div class="space-y-4">
    <% @sources.each do |source| %>
      <article class="admin-panel flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div class="min-w-0 space-y-2">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <%= link_to source.name, source, class: "admin-link text-base" %>
            <span class="admin-badge bg-stone-100 text-stone-600"><%= source.source_type.upcase %></span>
            <%= render "ingestion_status", source: source %>
          </div>
          <% if source.url.present? %>
            <p class="break-all text-sm text-stone-500"><%= source.url %></p>
          <% end %>
          <p class="text-sm text-stone-500">
            <%= pluralize(source.documents.count, "document") %>
            <% if source.last_fetched_at %>
              &middot; Last ingested <%= time_ago_in_words(source.last_fetched_at) %> ago
            <% end %>
          </p>
        </div>
        <%= button_to "Delete", source_path(source), method: :delete, class: "admin-button-danger",
            form: { class: "shrink-0" }, data: { turbo_confirm: "Delete source '#{source.name}' and all its documents?" } %>
      </article>
    <% end %>

    <% @documents.each do |document| %>
      <article class="admin-panel flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div class="min-w-0 space-y-2">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
            <%= link_to document.title.presence || "Untitled", document, class: "admin-link text-base" %>
            <span class="admin-badge bg-sage-50 text-sage-700">FORM</span>
          </div>
          <p class="break-words text-sm text-stone-500">
            <%= [document.location.city.presence, document.category_names.presence&.join(", ")].compact.join(" · ") %>
          </p>
          <p class="text-sm text-stone-500">Added <%= time_ago_in_words(document.created_at) %> ago</p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-2">
          <%= link_to "Edit", edit_document_path(document), class: "admin-button-secondary" %>
          <%= button_to "Delete", document_path(document), method: :delete, class: "admin-button-danger", data: { turbo_confirm: "Delete resource '#{document.title}'?" } %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="admin-empty-state">No sources have been added yet.</p>
<% end %>
