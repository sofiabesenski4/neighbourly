<%# Shows ingestion progress for an uploaded source. Finished sources and form entries show nothing. %>
<% case source.ingestion_status %>
<% when "pending" %>
  <span class="admin-badge bg-amber-100 text-amber-800">Waiting to ingest</span>
<% when "ingesting" %>
  <span class="admin-badge bg-sage-100 text-sage-800">Ingesting</span>
<% when "failed" %>
  <span class="admin-badge bg-red-100 text-red-800">Ingestion failed</span>
<% end %>
