<%# Shows ingestion progress for an uploaded source. Finished sources and form entries show nothing. %>
<% case source.ingestion_status %>
<% when "pending" %>
  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">Waiting to ingest</span>
<% when "ingesting" %>
  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">Ingesting</span>
<% when "failed" %>
  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Ingestion failed</span>
<% end %>
