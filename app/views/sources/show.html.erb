<% content_for :title, @source.name %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @source %>
<% content_for :admin_actions do %>
  <%= link_to "Back to sources", sources_path, class: "admin-button-secondary" %>
  <%= button_to "Delete", source_path(@source), method: :delete, class: "admin-button-danger", data: { turbo_confirm: "Delete source '#{@source.name}' and all its documents?" } %>
<% end %>

<%= render "admin/page_header", title: @source.name, description: "Review this source and the documents it contributes to community search." %>

<div class="admin-panel mb-6 space-y-3 p-5 sm:p-6">
  <div class="flex flex-wrap items-center gap-3 text-sm text-stone-600">
    <span class="admin-badge bg-stone-100 text-stone-600"><%= @source.source_type.upcase %></span>
    <%= render "ingestion_status", source: @source %>
    <span><%= pluralize(@documents.count, "document") %></span>
    <% if @source.last_fetched_at %>
      <span>Last ingested <%= time_ago_in_words(@source.last_fetched_at) %> ago</span>
    <% end %>
  </div>
  <% if @source.url.present? %>
    <p class="break-all text-sm text-stone-500"><%= @source.url %></p>
  <% end %>
  <% if @source.ingestion_failed? %>
    <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-800">
      <p class="text-sm font-medium">Ingestion stopped with an error. Documents saved before the error are kept.</p>
      <p class="mt-1 break-words text-sm leading-6"><%= @source.ingestion_error %></p>
    </div>
  <% elsif @source.ingestion_pending? || @source.ingestion_ingesting? %>
    <p class="text-sm text-stone-600">This page updates when ingestion finishes.</p>
  <% end %>
</div>

<% if @documents.any? %>
  <div class="space-y-4">
    <% @documents.each do |doc| %>
      <article id="document_<%= doc.id %>" class="admin-panel p-5 sm:p-6">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <h2 class="min-w-0 font-semibold text-stone-900"><%= link_to doc.title.presence || "Untitled", doc, class: "admin-link text-base" %></h2>
          <%= button_to "Delete", document_path(doc), method: :delete, class: "admin-button-danger", form: { class: "shrink-0" }, data: { turbo_confirm: "Delete document '#{doc.title}'?" } %>
        </div>
        <% if doc.metadata.present? %>
          <dl class="mt-4 grid grid-cols-1 gap-x-6 gap-y-4 text-sm sm:grid-cols-2">
            <% doc.metadata.each do |key, value| %>
              <% next if value.blank? %>
              <div class="min-w-0">
                <dt class="font-medium text-stone-500"><%= key.to_s.titleize %></dt>
                <dd class="mt-1 break-words text-stone-900">
                  <% if value.is_a?(Array) %>
                    <%= value.join(", ") %>
                  <% elsif value.is_a?(Hash) %>
                    <%= value.map { |k, v| "#{k}: #{v}" }.join(", ") %>
                  <% else %>
                    <%= value %>
                  <% end %>
                </dd>
              </div>
            <% end %>
          </dl>
        <% end %>
        <% if doc.content.present? %>
          <details class="mt-4 border-t border-stone-100 pt-1">
            <summary class="min-h-11 cursor-pointer py-3 text-sm font-medium text-sage-700 focus-visible:outline-sage-600">Raw content</summary>
            <pre class="max-h-48 overflow-auto whitespace-pre-wrap rounded-xl bg-stone-50 p-4 text-xs leading-6 text-stone-600 [overflow-wrap:anywhere]"><%= doc.content %></pre>
          </details>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <p class="admin-empty-state">No documents in this source.</p>
<% end %>
